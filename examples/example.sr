#include <stdio.h>

state FileState {
  Closed {
    open() -> Opened;
  }
  Opened {
    close() -> Closed;
  }
};

struct File {
  FileState Closed;
  int x;
};

void open(File* f) {
  f->x = 10;
}

void close(File* f) {
  f->x = 20;
}

int main() {
  File file;
  file.open();
  file.close();
  printf("%d\n", file.x);
  return 0;
}
